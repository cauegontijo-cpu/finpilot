# Copie para .env e substitua TODOS os valores. Nunca versione o .env.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=development
SECRET_KEY=troque-por-um-valor-aleatorio-de-48-caracteres
BASE_URL=http://localhost:8000

# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=troque-me
MIGRATOR_DB_PASSWORD=troque-me
APP_DB_PASSWORD=troque-me

# Execução local fora do Docker (uvicorn/pytest no host)
DATABASE_URL=postgresql+psycopg://finpilot_app:troque-me@127.0.0.1:5432/finpilot
MIGRATOR_DATABASE_URL=postgresql+psycopg://finpilot_migrator:troque-me@127.0.0.1:5432/finpilot
TEST_DATABASE_URL=postgresql+psycopg://finpilot_test:finpilot_test@127.0.0.1:5433/finpilot_test
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_BACKEND=redis

# E-mail (Mailpit em desenvolvimento: http://localhost:8025)
EMAIL_BACKEND=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="FinPilot <no-reply@finpilot.local>"

# Sessão
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=168

# Usuário de demonstração (somente ENV=development; deixe vazio para não criar)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=troque-por-uma-senha-forte

LOG_LEVEL=INFO
